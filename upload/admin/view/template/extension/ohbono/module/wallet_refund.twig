<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">
            OHBONO Wallet Refund
        </h5>

        <input type="hidden"
               name="customer_id"
               value="{{ customer_id }}">

        <input type="hidden"
               name="order_id"
               value="{{ order_id }}">

        <div class="mb-3">
            <label class="form-label">
                {{ text_reference }}
            </label>

            <input type="text"
                   name="reference"
                   required
                   minlength="5"
                   class="form-control"
                   placeholder="Example: REFUND-ORDER-123">
        </div>

        <div class="mb-3">
            <label class="form-label">
                {{ text_reason }}
            </label>

            <textarea name="reason"
                      required
                      minlength="5"
                      rows="4"
                      class="form-control"></textarea>
        </div>

        <button type="button"
                id="ohbono-wallet-refund"
                class="btn btn-warning">
            Refund Wallet Payment
        </button>

        <div id="ohbono-wallet-refund-result"
             class="mt-3"></div>
    </div>
</div>

<script>
(function () {
    const button =
        document.getElementById('ohbono-wallet-refund');

    if (!button) {
        return;
    }

    button.addEventListener('click', function () {
        const card = button.closest('.card');

        const formData = new FormData();

        formData.append(
            'customer_id',
            card.querySelector('[name="customer_id"]').value
        );

        formData.append(
            'order_id',
            card.querySelector('[name="order_id"]').value
        );

        formData.append(
            'reference',
            card.querySelector('[name="reference"]').value
        );

        formData.append(
            'reason',
            card.querySelector('[name="reason"]').value
        );

        fetch('{{ action }}', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            const result =
                document.getElementById(
                    'ohbono-wallet-refund-result'
                );

            result.className =
                data.success
                    ? 'alert alert-success mt-3'
                    : 'alert alert-danger mt-3';

            result.textContent =
                data.success
                    ? 'Wallet refund completed. Transaction #' +
                        data.transaction_id
                    : (data.error ||
                        'Wallet refund failed.');
        })
        .catch(function () {
            const result =
                document.getElementById(
                    'ohbono-wallet-refund-result'
                );

            result.className =
                'alert alert-danger mt-3';

            result.textContent =
                'Unable to communicate with the server.';
        });
    });
})();
</script>
