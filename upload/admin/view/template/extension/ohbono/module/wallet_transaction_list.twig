{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
        </div>
    </div>

    <div class="container-fluid">
        <div class="card mb-3">
            <div class="card-header">
                <i class="fa-solid fa-filter"></i> {{ button_filter }}
            </div>

            <div class="card-body">
                <form action="{{ filter_url }}" method="get">
                    <input type="hidden" name="user_token" value="{{ user_token }}">

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">{{ entry_customer }}</label>
                            <input type="text" name="filter_customer" value="{{ filters.filter_customer }}" class="form-control" placeholder="Name, email or ID">
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">{{ entry_type }}</label>
                            <input type="text" name="filter_type" value="{{ filters.filter_type }}" class="form-control" placeholder="e.g. cashback">
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">{{ entry_direction }}</label>
                            <select name="filter_direction" class="form-select">
                                <option value="">{{ text_all }}</option>
                                <option value="credit"{% if filters.filter_direction == 'credit' %} selected{% endif %}>{{ text_credit }}</option>
                                <option value="debit"{% if filters.filter_direction == 'debit' %} selected{% endif %}>{{ text_debit }}</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">{{ entry_order_id }}</label>
                            <input type="number" name="filter_order_id" value="{{ filters.filter_order_id }}" class="form-control" min="1">
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa-solid fa-filter"></i> {{ button_filter }}
                            </button>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">{{ entry_date_start }}</label>
                            <input type="date" name="filter_date_start" value="{{ filters.filter_date_start }}" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">{{ entry_date_end }}</label>
                            <input type="date" name="filter_date_end" value="{{ filters.filter_date_end }}" class="form-control">
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-list"></i> {{ text_list }}
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead>
                            <tr>
                                <th>{{ column_date }}</th>
                                <th>{{ column_customer }}</th>
                                <th>{{ column_order }}</th>
                                <th>{{ column_type }}</th>
                                <th>{{ column_direction }}</th>
                                <th class="text-end">{{ column_amount }}</th>
                                <th class="text-end">{{ column_balance_before }}</th>
                                <th class="text-end">{{ column_balance_after }}</th>
                                <th>{{ column_reference }}</th>
                                <th>{{ column_comment }}</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for transaction in transactions %}
                                <tr>
                                    <td>{{ transaction.date }}</td>
                                    <td>
                                        <strong>{{ transaction.customer }}</strong>
                                        {% if transaction.email %}
                                            <div class="small text-muted">{{ transaction.email }}</div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if transaction.order_id %}
                                            #{{ transaction.order_id }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>{{ transaction.type }}</td>
                                    <td>
                                        {% if transaction.direction == 'credit' %}
                                            <span class="badge bg-success">{{ text_credit }}</span>
                                        {% else %}
                                            <span class="badge bg-danger">{{ text_debit }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">{{ transaction.amount }}</td>
                                    <td class="text-end">{{ transaction.balance_before }}</td>
                                    <td class="text-end">{{ transaction.balance_after }}</td>
                                    <td>{{ transaction.reference }}</td>
                                    <td>{{ transaction.comment }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="10" class="text-center py-4">No transactions found.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer">
                <div class="row">
                    <div class="col-sm-6">{{ pagination }}</div>
                    <div class="col-sm-6 text-end">{{ results }}</div>
                </div>
            </div>
        </div>
    </div>
</div>
{{ footer }}
