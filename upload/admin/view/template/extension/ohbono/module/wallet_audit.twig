{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <div class="small text-muted">
                            Total Transactions
                        </div>
                        <div id="audit-transaction-count"
                             class="fs-3 fw-bold">--</div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <div class="small text-muted">
                            Total Credits
                        </div>
                        <div id="audit-credit-total"
                             class="fs-3 fw-bold">--</div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <div class="small text-muted">
                            Total Debits
                        </div>
                        <div id="audit-debit-total"
                             class="fs-3 fw-bold">--</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ footer }}
