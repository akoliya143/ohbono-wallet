{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
        </div>
    </div>

    <div class="container-fluid">
        {% if success %}
            <div class="alert alert-success alert-dismissible">
                {{ success }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-wallet"></i>
                {{ heading_title }}
            </div>

            <div class="card-body">
                <form action="{{ action }}" method="post">
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label">
                            {{ entry_status }}
                        </label>

                        <div class="col-sm-9">
                            <div class="form-check form-switch">
                                <input type="checkbox"
                                       name="status"
                                       value="1"
                                       class="form-check-input"
                                       {% if status %}checked{% endif %}>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label">
                            {{ entry_sort_order }}
                        </label>

                        <div class="col-sm-9">
                            <input type="number"
                                   name="sort_order"
                                   value="{{ sort_order }}"
                                   min="0"
                                   class="form-control">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label">
                            {{ entry_maximum_use }}
                        </label>

                        <div class="col-sm-9">
                            <input type="number"
                                   name="maximum_use"
                                   value="{{ maximum_use }}"
                                   min="0"
                                   step="0.0001"
                                   class="form-control">

                            <div class="form-text">
                                {{ help_maximum_use }}
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label">
                            {{ entry_reservation_ttl }}
                        </label>

                        <div class="col-sm-9">
                            <input type="number"
                                   name="reservation_ttl"
                                   value="{{ reservation_ttl }}"
                                   min="300"
                                   step="1"
                                   class="form-control">

                            <div class="form-text">
                                {{ help_reservation_ttl }}
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i>
                            {{ button_save }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{{ footer }}
