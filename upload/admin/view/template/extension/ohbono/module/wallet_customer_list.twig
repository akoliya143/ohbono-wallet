{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
        </div>
    </div>

    <div class="container-fluid">
        <div class="card mb-3">
            <div class="card-body">
                <form action="{{ action }}" method="get">
                    <input type="hidden" name="user_token" value="{{ user_token }}">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">{{ entry_customer }}</label>
                            <input type="text"
                                   name="filter_customer"
                                   value="{{ filter_customer }}"
                                   class="form-control"
                                   placeholder="Name, email or customer ID">
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary w-100" type="submit">
                                <i class="fa-solid fa-filter"></i> {{ button_filter }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-wallet"></i> {{ text_list }}
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead>
                            <tr>
                                <th>{{ column_customer }}</th>
                                <th>{{ column_email }}</th>
                                <th class="text-end">{{ column_balance }}</th>
                                <th>{{ column_status }}</th>
                                <th class="text-end">{{ column_action }}</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for wallet in wallets %}
                                <tr>
                                    <td>
                                        <strong>{{ wallet.customer }}</strong>
                                        <div class="small text-muted">ID: {{ wallet.customer_id }}</div>
                                    </td>
                                    <td>{{ wallet.email }}</td>
                                    <td class="text-end fw-bold">{{ wallet.balance }}</td>
                                    <td>
                                        {% if wallet.status %}
                                            <span class="badge bg-success">{{ text_enabled }}</span>
                                        {% else %}
                                            <span class="badge bg-secondary">{{ text_disabled }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ wallet.manage }}" class="btn btn-primary btn-sm">
                                            <i class="fa-solid fa-wallet"></i> {{ button_manage }}
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        No wallet customers found.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer">
                {{ pagination }}
            </div>
        </div>
    </div>
</div>

{{ footer }}
