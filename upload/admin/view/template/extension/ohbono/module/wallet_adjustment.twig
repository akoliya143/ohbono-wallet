{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
        </div>
    </div>

    <div class="container-fluid">
        {% if customer %}
            <div class="card mb-3">
                <div class="card-body">
                    <strong>
                        {{ customer.firstname }}
                        {{ customer.lastname }}
                    </strong>

                    <div class="small text-muted">
                        {{ customer.email }}
                    </div>

                    <div class="mt-2">
                        Current balance:
                        <strong>
                            {{ customer.balance|default('0.00') }}
                        </strong>
                    </div>
                </div>
            </div>

            <div id="ohbono-adjustment-error"
                 class="alert alert-danger d-none"></div>

            <div id="ohbono-adjustment-success"
                 class="alert alert-success d-none"></div>

            <form id="ohbono-wallet-adjustment"
                  action="{{ action }}"
                  method="post"
                  class="card">

                <div class="card-body">
                    <input type="hidden"
                           name="customer_id"
                           value="{{ customer_id }}">

                    <div class="mb-3">
                        <label class="form-label">
                            {{ text_amount }}
                        </label>

                        <input type="number"
                               name="amount"
                               min="0.01"
                               step="0.01"
                               required
                               class="form-control">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Adjustment
                        </label>

                        <select name="direction"
                                class="form-select"
                                required>
                            <option value="credit">
                                {{ text_credit }}
                            </option>
                            <option value="debit">
                                {{ text_debit }}
                            </option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            {{ text_reason }}
                        </label>

                        <textarea name="reason"
                                  rows="4"
                                  required
                                  minlength="5"
                                  class="form-control"
                                  placeholder="Explain why this adjustment is required"></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">
                            {{ text_reference }}
                        </label>

                        <input type="text"
                               name="reference"
                               required
                               minlength="5"
                               class="form-control"
                               placeholder="Example: ADMIN-2026-000001">
                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        {{ button_submit }}
                    </button>
                </div>
            </form>
        {% else %}
            <div class="alert alert-danger">
                Customer wallet not found.
            </div>
        {% endif %}
    </div>
</div>

<script>
(function () {
    const form =
        document.getElementById('ohbono-wallet-adjustment');

    if (!form) {
        return;
    }

    const error =
        document.getElementById('ohbono-adjustment-error');

    const success =
        document.getElementById('ohbono-adjustment-success');

    form.addEventListener('submit', function (event) {
        event.preventDefault();

        error.classList.add('d-none');
        success.classList.add('d-none');

        fetch(form.action, {
            method: 'POST',
            body: new FormData(form)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                success.textContent =
                    'Adjustment completed. Transaction #' +
                    data.transaction_id;

                success.classList.remove('d-none');

                form.reset();

                form.querySelector(
                    '[name="customer_id"]'
                ).value = '{{ customer_id }}';
            } else {
                error.textContent =
                    data.error || 'Unable to apply adjustment.';

                error.classList.remove('d-none');
            }
        })
        .catch(function () {
            error.textContent =
                'Unable to communicate with the server.';

            error.classList.remove('d-none');
        });
    });
})();
</script>

{{ footer }}
