{# Commit 0034 additions: replace/add the adjustment form fields below. #}
<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">{{ entry_amount }}</label>
        <input type="number"
               name="amount"
               class="form-control"
               min="0.01"
               max="100000000"
               step="0.01"
               required>
    </div>

    <div class="col-md-6">
        <label class="form-label">{{ entry_reference }}</label>
        <input type="text"
               name="reference"
               class="form-control"
               maxlength="128">
    </div>

    <div class="col-12">
        <label class="form-label">{{ entry_comment }}</label>
        <textarea name="comment"
                  class="form-control"
                  rows="2"
                  maxlength="500"></textarea>
    </div>

    <div class="col-12">
        <label class="form-label">
            {{ entry_reason }} <span class="text-danger">*</span>
        </label>

        <textarea name="reason"
                  class="form-control"
                  rows="3"
                  maxlength="500"
                  required
                  placeholder="{{ help_reason }}"></textarea>
    </div>
</div>
