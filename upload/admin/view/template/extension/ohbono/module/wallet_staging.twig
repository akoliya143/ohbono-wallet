{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
        </div>
    </div>

    <div class="container-fluid">
        <div class="alert alert-info">
            These are staging verification records. They do not represent
            financial ledger entries.
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Scenario</th>
                            <th>Result</th>
                            <th>Order</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for row in results %}
                            <tr>
                                <td>{{ row.date_added }}</td>
                                <td>{{ row.scenario }}</td>
                                <td>
                                    <span class="badge">
                                        {{ row.result }}
                                    </span>
                                </td>
                                <td>
                                    {% if row.order_id %}
                                        #{{ row.order_id }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>{{ row.notes }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5"
                                    class="text-center py-5">
                                    No staging results recorded.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{{ footer }}
