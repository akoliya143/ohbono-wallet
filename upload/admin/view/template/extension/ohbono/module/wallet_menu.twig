<div class="card mb-3">
    <div class="card-header">
        <i class="fa-solid fa-wallet"></i> {{ heading_title }}
    </div>

    <div class="list-group list-group-flush">
        <a href="{{ dashboard }}" class="list-group-item list-group-item-action">
            <i class="fa-solid fa-gauge-high fa-fw"></i> {{ text_dashboard }}
        </a>

        <a href="{{ customers }}" class="list-group-item list-group-item-action">
            <i class="fa-solid fa-users fa-fw"></i> {{ text_customers }}
        </a>

        <a href="{{ settings }}" class="list-group-item list-group-item-action">
            <i class="fa-solid fa-gear fa-fw"></i> {{ text_settings }}
        </a>

        <a href="{{ payment }}" class="list-group-item list-group-item-action">
            <i class="fa-solid fa-credit-card fa-fw"></i> {{ text_payment }}
        </a>
    </div>
</div>
