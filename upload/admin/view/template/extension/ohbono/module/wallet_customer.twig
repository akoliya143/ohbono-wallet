{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
        </div>
    </div>

    <div class="container-fluid">
        <form method="get" class="card mb-3">
            <div class="card-body row g-2">
                <input type="hidden"
                       name="route"
                       value="extension/ohbono/module/wallet_customer">

                <div class="col-md-4">
                    <input type="text"
                           name="filter_name"
                           value="{{ filter_name }}"
                           class="form-control"
                           placeholder="Customer name">
                </div>

                <div class="col-md-4">
                    <input type="text"
                           name="filter_email"
                           value="{{ filter_email }}"
                           class="form-control"
                           placeholder="Email">
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary">
                        {{ text_filter }}
                    </button>
                </div>
            </div>
        </form>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Email</th>
                            <th>Wallet</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th>Modified</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for customer in customers %}
                            <tr>
                                <td>{{ customer.customer_id }}</td>
                                <td>
                                    {{ customer.firstname }}
                                    {{ customer.lastname }}
                                </td>
                                <td>{{ customer.email }}</td>
                                <td>
                                    {% if customer.wallet_id %}
                                        #{{ customer.wallet_id }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>
                                    {{ customer.balance|default('0.00') }}
                                </td>
                                <td>
                                    {% if customer.wallet_status %}
                                        {{ text_active }}
                                    {% else %}
                                        {{ text_disabled }}
                                    {% endif %}
                                </td>
                                <td>
                                    {{ customer.date_modified|default('-') }}
                                </td>
                                <td class="text-end">
                                    {% if customer.wallet_id %}
                                        <a href="{{ url('extension/ohbono/module/wallet_adjustment', 'customer_id=' ~ customer.customer_id) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            {{ text_adjust }}
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8"
                                    class="text-center py-5">
                                    {{ text_no_results }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{{ footer }}
