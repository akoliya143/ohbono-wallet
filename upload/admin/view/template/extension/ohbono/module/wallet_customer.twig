{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <h1>{{ heading_title }}</h1>

                {% if customer %}
                    <a href="{{ adjust_url }}&customer_id={{ customer.customer_id }}"
                       class="btn btn-primary">
                        <i class="fa-solid fa-wallet"></i>
                        {{ button_adjust }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="card mb-4">
            <div class="card-header">
                {{ entry_customer }}
            </div>

            <div class="card-body">
                <form action="{{ search_url }}" method="get">
                    <input type="hidden"
                           name="user_token"
                           value="{{ user_token }}">

                    <div class="input-group">
                        <input type="number"
                               name="customer_id"
                               value="{{ customer_id }}"
                               min="1"
                               class="form-control"
                               placeholder="{{ entry_customer }}">

                        <button class="btn btn-primary" type="submit">
                            {{ button_search }}
                        </button>
                    </div>
                </form>
            </div>
        </div>

        {% if customer %}
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="small text-muted">
                                {{ customer.customer }}
                            </div>
                            <div class="small">
                                {{ customer.email }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="small text-muted">
                                {{ text_balance }}
                            </div>
                            <div class="fs-3 fw-bold">
                                {{ customer.balance }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="small text-muted">
                                {{ text_status }}
                            </div>

                            {% if customer.status %}
                                <span class="badge bg-success">
                                    {{ text_active }}
                                </span>
                            {% else %}
                                <span class="badge bg-secondary">
                                    {{ text_disabled }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    {{ text_transactions }}
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Type</th>
                                <th>Direction</th>
                                <th>Amount</th>
                                <th>Balance After</th>
                                <th>Reference</th>
                                <th>Order</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for transaction in transactions %}
                                <tr>
                                    <td>{{ transaction.transaction_id }}</td>
                                    <td>{{ transaction.type }}</td>
                                    <td>{{ transaction.direction }}</td>
                                    <td>{{ transaction.amount }}</td>
                                    <td>{{ transaction.balance_after }}</td>
                                    <td>{{ transaction.reference }}</td>
                                    <td>{{ transaction.order_id ?: '-' }}</td>
                                    <td>{{ transaction.date_added }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8"
                                        class="text-center py-4">
                                        {{ text_no_transactions }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
</div>

{{ footer }}
