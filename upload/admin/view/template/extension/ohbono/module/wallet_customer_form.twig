{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="float-end">
                <a href="{{ back }}" class="btn btn-light">
                    <i class="fa-solid fa-reply"></i> {{ button_back }}
                </a>
            </div>

            <h1>{{ heading_title }}</h1>
        </div>
    </div>

    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
            </div>
        {% endif %}

        {% if success %}
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i> {{ success }}
            </div>
        {% endif %}

        <div class="card mb-3">
            <div class="card-header">
                <strong>{{ text_manage }}</strong>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="small text-muted">Customer</div>
                        <div class="fw-bold">{{ customer }}</div>
                        <div class="text-muted">{{ email }}</div>
                        <div class="small text-muted mt-1">Customer ID: {{ customer_id }}</div>
                    </div>

                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        <div class="small text-muted">Current Balance</div>
                        <div class="display-6 fw-bold">{{ balance }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <strong>Manual Wallet Adjustment</strong>
            </div>

            <div class="card-body">
                <form action="{{ action }}" method="post">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">{{ entry_direction }}</label>
                            <select name="direction" class="form-select">
                                <option value="credit">{{ text_credit }}</option>
                                <option value="debit">{{ text_debit }}</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">{{ entry_amount }}</label>
                            <input type="number"
                                   name="amount"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control"
                                   required>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">{{ entry_reference }}</label>
                            <input type="text"
                                   name="reference"
                                   maxlength="128"
                                   class="form-control">
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">{{ entry_comment }}</label>
                            <input type="text"
                                   name="comment"
                                   maxlength="255"
                                   class="form-control">
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-wallet"></i> {{ button_save }}
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>{{ text_history }}</strong>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead>
                            <tr>
                                <th>{{ column_date }}</th>
                                <th>{{ column_type }}</th>
                                <th>{{ column_direction }}</th>
                                <th class="text-end">{{ column_amount }}</th>
                                <th class="text-end">{{ column_before }}</th>
                                <th class="text-end">{{ column_after }}</th>
                                <th>{{ column_reference }}</th>
                                <th>{{ column_comment }}</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for transaction in transactions %}
                                <tr>
                                    <td>{{ transaction.date }}</td>
                                    <td>{{ transaction.type }}</td>
                                    <td>
                                        {% if transaction.direction == 'credit' %}
                                            <span class="badge bg-success">{{ text_credit }}</span>
                                        {% else %}
                                            <span class="badge bg-danger">{{ text_debit }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">{{ transaction.amount }}</td>
                                    <td class="text-end">{{ transaction.before }}</td>
                                    <td class="text-end">{{ transaction.after }}</td>
                                    <td>{{ transaction.reference }}</td>
                                    <td>{{ transaction.comment }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        No wallet transactions found.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{{ footer }}
