{{ header }}

<div id="account-wallet-history" class="container">
    <div class="row">
        {{ column_left }}

        <div id="content" class="col">
            {{ content_top }}

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ heading_title }}</h1>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Balance</th>
                                <th>Reference</th>
                                <th>Order</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for transaction in transactions %}
                                <tr>
                                    <td>{{ transaction.date_added }}</td>

                                    <td>
                                        {% if transaction.direction == 'credit' %}
                                            <span class="badge bg-success">
                                                {{ text_credit }}
                                            </span>
                                        {% else %}
                                            <span class="badge bg-danger">
                                                {{ text_debit }}
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {{ transaction.amount }}
                                    </td>

                                    <td>
                                        {{ transaction.balance_after }}
                                    </td>

                                    <td>
                                        {{ transaction.reference }}
                                    </td>

                                    <td>
                                        {% if transaction.order_id %}
                                            #{{ transaction.order_id }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>

                                    <td class="text-end">
                                        <a href="{{ transaction_links[transaction.transaction_id] }}"
                                           class="btn btn-sm btn-outline-primary">
                                            {{ text_view }}
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7"
                                        class="text-center py-5">
                                        {{ text_no_results }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if pagination %}
                <div class="mt-4">
                    {{ pagination }}
                </div>
            {% endif %}

            {{ content_bottom }}
        </div>

        {{ column_right }}
    </div>
</div>

{{ footer }}
