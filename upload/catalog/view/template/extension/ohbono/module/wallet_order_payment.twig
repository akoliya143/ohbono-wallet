<div id="ohbono-wallet-order-payment"
     class="alert alert-info">
    <div class="fw-semibold">
        {{ text_wallet_payment }}
    </div>

    <div class="mt-1">
        {{ text_wallet_payment_applied }}:
        <strong id="ohbono-wallet-applied">
            {{ wallet_amount }}
        </strong>
    </div>

    <div class="mt-1">
        {{ text_wallet_remaining_payment }}:
        <strong id="ohbono-wallet-remaining">
            {{ remaining_amount }}
        </strong>
    </div>
</div>
