<div id="ohbono-wallet-payment-method"
     class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="form-check">
            <input class="form-check-input"
                   type="radio"
                   name="payment_method"
                   id="ohbono-wallet-payment"
                   value="ohbono_wallet">

            <label class="form-check-label fw-semibold"
                   for="ohbono-wallet-payment">
                {{ title }}
            </label>
        </div>

        <div class="small text-muted mt-2">
            {{ text_wallet_balance }}:
            <strong>{{ balance }}</strong>
        </div>

        <div class="small text-muted mt-2">
            {{ text_wallet_authorization }}
        </div>

        <input type="hidden"
               name="ohbono_wallet_balance"
               value="{{ balance_raw }}">
    </div>
</div>
