<div id="ohbono-wallet-checkout" class="card mb-3">
    <div class="card-header">
        <strong>{{ heading_title }}</strong>
    </div>

    <div class="card-body">
        <div class="mb-2">
            <span class="text-muted">{{ text_available }}:</span>
            <strong>{{ text_balance }}</strong>
        </div>

        <div class="input-group">
            <input
                type="number"
                id="ohbono-wallet-amount"
                class="form-control"
                min="0.0001"
                step="0.0001"
                value="{{ wallet_use > 0 ? wallet_use : '' }}"
                placeholder="{{ text_amount }}"
                autocomplete="off"
            >

            <button type="button" id="ohbono-wallet-apply" class="btn btn-primary">
                {{ text_apply }}
            </button>

            <button type="button" id="ohbono-wallet-remove" class="btn btn-outline-secondary">
                {{ text_remove }}
            </button>
        </div>

        <div id="ohbono-wallet-message" class="small mt-2" role="status" aria-live="polite"></div>
    </div>
</div>

<script>
(function () {
    'use strict';

    const root = document.getElementById('ohbono-wallet-checkout');

    if (!root) {
        return;
    }

    const applyUrl = {{ apply|json_encode|raw }};
    const removeUrl = {{ remove|json_encode|raw }};
    const amountInput = document.getElementById('ohbono-wallet-amount');
    const messageElement = document.getElementById('ohbono-wallet-message');
    const applyButton = document.getElementById('ohbono-wallet-apply');
    const removeButton = document.getElementById('ohbono-wallet-remove');

    function setBusy(busy) {
        applyButton.disabled = busy;
        removeButton.disabled = busy;
        amountInput.disabled = busy;
    }

    function message(text, success) {
        messageElement.className = 'small mt-2 ' + (success ? 'text-success' : 'text-danger');
        messageElement.textContent = text;
    }

    function dispatchRefresh() {
        document.dispatchEvent(new CustomEvent('ohbono:wallet-applied', {
            detail: {
                source: 'ohbono-wallet'
            }
        }));

        /*
         * Journal 4 adapter hook.
         *
         * Journal integration can listen for this event and execute its
         * native checkout refresh method. The wallet module itself does not
         * call private Journal functions, keeping the extension update-safe.
         */
    }

    applyButton.addEventListener('click', function () {
        const amount = amountInput.value;

        if (!amount || parseFloat(amount) <= 0) {
            message('Please enter a valid wallet amount.', false);
            return;
        }

        setBusy(true);

        fetch(applyUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({
                amount: amount
            }).toString()
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            return response.json();
        })
        .then(function (result) {
            if (!result.success) {
                throw new Error(result.error || 'Unable to apply wallet.');
            }

            amountInput.value = result.wallet_use;
            message(
                'Wallet applied: ' + result.formatted_wallet_use +
                '. Remaining: ' + result.formatted_remaining,
                true
            );

            dispatchRefresh();
        })
        .catch(function (error) {
            message(error.message || 'Unable to apply wallet. Please try again.', false);
        })
        .finally(function () {
            setBusy(false);
        });
    });

    removeButton.addEventListener('click', function () {
        setBusy(true);

        fetch(removeUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            return response.json();
        })
        .then(function (result) {
            if (!result.success) {
                throw new Error('Unable to remove wallet payment.');
            }

            amountInput.value = '';
            message('Wallet payment removed.', true);
            dispatchRefresh();
        })
        .catch(function (error) {
            message(error.message || 'Unable to remove wallet payment.', false);
        })
        .finally(function () {
            setBusy(false);
        });
    });

    /*
     * Allows a Journal adapter or another checkout integration to request a
     * wallet-total refresh without knowing the wallet's internal structure.
     */
    document.addEventListener('ohbono:wallet-refresh', function () {
        dispatchRefresh();
    });
})();
</script>
