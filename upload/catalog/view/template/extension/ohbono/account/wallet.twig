{{ header }}

<div id="content">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>{{ heading_title }}</h1>
                    <a href="{{ back }}" class="btn btn-outline-secondary">Back to Account</a>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="small text-muted">{{ text_balance }}</div>
                        <div class="fs-2 fw-bold">{{ balance }}</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <strong>{{ text_history }}</strong>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ column_date }}</th>
                                        <th>{{ column_description }}</th>
                                        <th>{{ column_order }}</th>
                                        <th class="text-end">{{ column_credit }}</th>
                                        <th class="text-end">{{ column_debit }}</th>
                                        <th class="text-end">{{ column_balance }}</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    {% for transaction in transactions %}
                                        <tr>
                                            <td>{{ transaction.date }}</td>
                                            <td>{{ transaction.description }}</td>
                                            <td>
                                                {% if transaction.order_id %}
                                                    #{{ transaction.order_id }}
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </td>
                                            <td class="text-end text-success">
                                                {{ transaction.credit }}
                                            </td>
                                            <td class="text-end text-danger">
                                                {{ transaction.debit }}
                                            </td>
                                            <td class="text-end">
                                                {{ transaction.balance }}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center py-4">
                                                {{ text_no_transactions }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer">
                        {{ pagination }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ footer }}
