{{ header }}

<div id="account-wallet-transaction" class="container">
    <div class="row">
        <div class="col">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <h1 class="mb-0">{{ heading_title }}</h1>

                <a href="{{ back }}" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-wallet"></i> {{ button_back }}
                </a>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <strong>
                        <i class="fa-solid fa-receipt"></i>
                        {{ text_details }}
                    </strong>
                </div>

                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-12 col-md-4">
                            <div class="small text-muted">{{ label_transaction_id }}</div>
                            <div class="fw-semibold">{{ transaction.transaction_id }}</div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="small text-muted">{{ label_date }}</div>
                            <div class="fw-semibold">{{ transaction.date }}</div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="small text-muted">{{ label_type }}</div>
                            <div class="fw-semibold">{{ transaction.type }}</div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="small text-muted">{{ label_direction }}</div>
                            {% if transaction.direction == 'credit' %}
                                <span class="badge bg-success">{{ text_credit }}</span>
                            {% else %}
                                <span class="badge bg-danger">{{ text_debit }}</span>
                            {% endif %}
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="small text-muted">{{ label_amount }}</div>
                            <div class="fw-bold">{{ transaction.amount }}</div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="small text-muted">{{ label_order }}</div>
                            <div class="fw-semibold">
                                {% if transaction.order_id %}
                                    #{{ transaction.order_id }}
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="small text-muted">{{ label_before }}</div>
                            <div>{{ transaction.before }}</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="small text-muted">{{ label_after }}</div>
                            <div>{{ transaction.after }}</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="small text-muted">{{ label_reference }}</div>
                            <div>{{ transaction.reference ?: '-' }}</div>
                        </div>

                        <div class="col-12">
                            <div class="small text-muted">{{ label_comment }}</div>
                            <div>{{ transaction.comment ?: '-' }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ footer }}
