<div id="ohbono-wallet-payment"
     class="card border-0 shadow-sm mb-3"
     data-confirm-url="{{ confirm_url }}"
     data-remove-url="{{ remove_url }}"
     data-cleanup-url="{{ cleanup_url }}">

    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div>
                <div class="fw-semibold">{{ text_title }}</div>
                <div class="small text-muted">
                    {{ text_balance }}:
                    <strong id="ohbono-wallet-balance">--</strong>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        id="ohbono-wallet-confirm"
                        class="btn btn-primary">
                    {{ button_apply }}
                </button>

                <button type="button"
                        id="ohbono-wallet-remove"
                        class="btn btn-outline-secondary d-none">
                    {{ button_remove }}
                </button>
            </div>
        </div>

        <div class="row g-2 mt-3 small">
            <div class="col-sm-4">
                {{ text_available }}:
                <strong id="ohbono-wallet-available">--</strong>
            </div>

            <div class="col-sm-4">
                {{ text_applied }}:
                <strong id="ohbono-wallet-applied">--</strong>
            </div>

            <div class="col-sm-4">
                {{ text_remaining }}:
                <strong id="ohbono-wallet-remaining">--</strong>
            </div>
        </div>

        <div id="ohbono-wallet-error"
             class="alert alert-danger mt-3 mb-0 d-none"></div>
    </div>
</div>

<script>
(function () {
    const box = document.getElementById('ohbono-wallet-payment');

    if (!box) {
        return;
    }

    const applyButton =
        document.getElementById('ohbono-wallet-confirm');

    const removeButton =
        document.getElementById('ohbono-wallet-remove');

    const errorBox =
        document.getElementById('ohbono-wallet-error');

    function total() {
        return Number(window.ohbonoWalletOrderTotal || 0);
    }

    function showError(message) {
        errorBox.textContent =
            message || 'Unable to update wallet payment.';
        errorBox.classList.remove('d-none');
    }

    function clearError() {
        errorBox.textContent = '';
        errorBox.classList.add('d-none');
    }

    function updateState(data) {
        document.getElementById('ohbono-wallet-balance').textContent =
            data.balance ?? '--';

        document.getElementById('ohbono-wallet-available').textContent =
            data.available ?? '--';

        document.getElementById('ohbono-wallet-applied').textContent =
            data.applied ?? data.amount ?? '--';

        document.getElementById('ohbono-wallet-remaining').textContent =
            data.remaining ?? '--';

        const applied = Number(data.applied ?? data.amount ?? 0);

        if (applied > 0) {
            applyButton.classList.add('d-none');
            removeButton.classList.remove('d-none');
        } else {
            applyButton.classList.remove('d-none');
            removeButton.classList.add('d-none');
        }
    }

    function refresh() {
        clearError();

        fetch(box.dataset.cleanupUrl, {
            method: 'POST'
        })
        .then(response => response.json())
        .then(() => {
            return fetch('{{ wallet_url }}', {
                method: 'POST',
                headers: {
                    'Content-Type':
                        'application/x-www-form-urlencoded'
                },
                body: 'total=' +
                    encodeURIComponent(total())
            });
        })
        .then(response => response.json())
        .then(data => {
            if (!data.success) {
                showError(data.error);
                return;
            }

            updateState(data);
        })
        .catch(function () {
            showError('Unable to refresh wallet information.');
        });
    }

    applyButton.addEventListener('click', function () {
        clearError();
        applyButton.disabled = true;

        fetch(box.dataset.confirmUrl, {
            method: 'POST',
            headers: {
                'Content-Type':
                    'application/x-www-form-urlencoded'
            },
            body: 'total=' +
                encodeURIComponent(total())
        })
        .then(response => response.json())
        .then(data => {
            if (!data.success) {
                showError(data.error);
                return;
            }

            updateState({
                balance: data.balance,
                available: data.available,
                applied: data.amount,
                remaining: data.remaining
            });

            document.dispatchEvent(
                new CustomEvent(
                    'ohbonoWalletPaymentConfirmed',
                    { detail: data }
                )
            );
        })
        .catch(function () {
            showError('Unable to apply wallet payment.');
        })
        .finally(function () {
            applyButton.disabled = false;
        });
    });

    removeButton.addEventListener('click', function () {
        clearError();
        removeButton.disabled = true;

        fetch(box.dataset.removeUrl, {
            method: 'POST'
        })
        .then(response => response.json())
        .then(data => {
            if (!data.success) {
                showError(data.error);
                return;
            }

            refresh();

            document.dispatchEvent(
                new CustomEvent(
                    'ohbonoWalletPaymentRemoved',
                    { detail: data }
                )
            );
        })
        .catch(function () {
            showError('Unable to remove wallet payment.');
        })
        .finally(function () {
            removeButton.disabled = false;
        });
    });

    /*
     * Journal and custom checkout layouts can call this function whenever
     * totals change after shipping, coupon or tax recalculation.
     */
    window.ohbonoWalletRefresh = refresh;

    /*
     * Initial stale-session cleanup and quote refresh.
     */
    refresh();
})();
</script>
