<div id="ohbono-wallet-payment"
     class="card border-0 shadow-sm mb-3"
     data-wallet-url="{{ wallet_url }}"
     data-apply-url="{{ apply_url }}"
     data-restore-url="{{ restore_url }}">

    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <strong>{{ text_title }}</strong>
                <div class="small text-muted">
                    {{ text_balance }}:
                    <span id="ohbono-wallet-balance">--</span>
                </div>
            </div>

            <button type="button"
                    id="ohbono-wallet-apply"
                    class="btn btn-primary">
                {{ text_applied }}
            </button>
        </div>

        <div class="small text-muted">
            {{ text_available }}:
            <span id="ohbono-wallet-available">--</span>
        </div>

        <div class="small text-muted">
            {{ text_remaining }}:
            <span id="ohbono-wallet-remaining">--</span>
        </div>

        <div id="ohbono-wallet-error"
             class="alert alert-danger mt-3 d-none"></div>
    </div>
</div>

<script>
(function () {
    const box = document.getElementById('ohbono-wallet-payment');

    if (!box) {
        return;
    }

    const button = document.getElementById('ohbono-wallet-apply');
    const errorBox = document.getElementById('ohbono-wallet-error');

    function showError(message) {
        errorBox.textContent = message || 'Unable to apply wallet payment.';
        errorBox.classList.remove('d-none');
    }

    button.addEventListener('click', function () {
        errorBox.classList.add('d-none');
        button.disabled = true;

        /*
         * The checkout integration that embeds this component must provide
         * the current order total in window.ohbonoWalletOrderTotal.
         */
        const total = Number(window.ohbonoWalletOrderTotal || 0);

        fetch(box.dataset.applyUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: 'total=' + encodeURIComponent(total)
        })
        .then(response => response.json())
        .then(data => {
            if (!data.success) {
                showError(data.error);
                return;
            }

            document.getElementById('ohbono-wallet-remaining').textContent =
                data.remaining;

            document.dispatchEvent(
                new CustomEvent('ohbonoWalletApplied', {
                    detail: data
                })
            );
        })
        .catch(function () {
            showError('Unable to apply wallet payment.');
        })
        .finally(function () {
            button.disabled = false;
        });
    });
})();
</script>
